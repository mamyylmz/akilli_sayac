{
  "name": "akilli-sayac",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Akıllı Sayaç yerel yazılım ve siber güvenlik altyapısı",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=12 <13"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "build:packages": "pnpm --filter './packages/*' -r build",
    "dev": "pnpm --parallel --filter @akilli-sayac/api --filter @akilli-sayac/web dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "test": "pnpm build:packages && vitest run",
    "test:coverage": "pnpm build:packages && vitest run --coverage",
    "typecheck": "pnpm -r --if-present typecheck",
    "security:dependencies": "pnpm audit --audit-level high",
    "verify": "pnpm typecheck && pnpm lint && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@typescript-eslint/eslint-plugin": "8.73.0",
    "@typescript-eslint/parser": "8.73.0",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "eslint": "10.15.0",
    "prettier": "3.10.1",
    "semver": "7.8.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  }
}
