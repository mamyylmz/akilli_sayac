# Safe examples only. Generate a fresh HMAC key; never commit its value.
AKILLI_SAYAC_HOST=127.0.0.1
AKILLI_SAYAC_PORT=3000
AKILLI_SAYAC_WEB_ORIGINS=http://127.0.0.1:5173
AKILLI_SAYAC_DB_PATH=./data/akilli-sayac.sqlite
AKILLI_SAYAC_IMPORT_DIR=./imports
AKILLI_SAYAC_METER_ID=SIM-0001
AKILLI_SAYAC_AMI_HMAC_KEY_HEX=<generate-64-random-hex-characters>

# JSON object mapping local bearer tokens to actor/role records. Keep only in .env.
AKILLI_SAYAC_LOCAL_TOKENS_JSON=<configure-locally-do-not-commit>
